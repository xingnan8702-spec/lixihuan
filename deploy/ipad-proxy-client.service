[Unit]
Description=iPad Proxy local SOCKS5 client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ipad-proxy
Group=ipad-proxy
ExecStart=/usr/local/bin/proxy-client -config /etc/ipad-proxy/client.json
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/ipad-proxy
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
